// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TripStatus {
  REQUESTED
  MATCHED
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVER_FOUND
}

model Trip {
  id           String     @id @default(uuid())
  riderId      String     // plain reference to User Service — no @relation
  driverId     String?    // plain reference to User Service — no @relation
  pickupLat    Decimal
  pickupLng    Decimal
  dropoffLat   Decimal
  dropoffLng   Decimal
  status       TripStatus @default(REQUESTED)
  fareEstimate Decimal?
  finalFare    Decimal?
  requestedAt  DateTime   @default(now())
  completedAt  DateTime?
  version      Int        @default(0)

  statusHistory TripStatusHistory[]   // one Trip -> many history rows
  outboxEvents  OutboxEvent[]         // one Trip -> many outbox events
}

// Audit trail: every status change gets a row here.
// Genuinely useful — lets you answer "when exactly did this trip
// get matched" without digging through logs.
model TripStatusHistory {
  id        String     @id @default(uuid())
  tripId    String
  trip      Trip       @relation(fields: [tripId], references: [id])
  status    TripStatus
  changedAt DateTime   @default(now())
}

// The Outbox pattern table from the HLD/LLD doc — this is what
// makes Kafka publishing reliable once you wire that in.
model OutboxEvent {
  id          String    @id @default(uuid())
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id])
  eventType   String    // 'trip.matched', 'trip.completed', ...
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
}
